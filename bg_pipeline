import sys
from pathlib import Path
from PIL import Image, ImageOps
from rembg import remove
import tqdm #Consider replacing with rich for better progress bar

'''
==========================================
File Loading & Input Handling
==========================================
'''

# Supported file extensions (images and videos) for background removal / processing
supported_types = [".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tiff", ".tif", ".img", ".mp4", ".mov", ".avi", ".mkv", ".webm", ".m4v", ".gif"]

files = []
inps = list(map(Path, input("Enter input path (File(s) or Folder Path): ").strip().split(",")))

for paths in tqdm(inps, desc="Collecting files"):
    if paths.suffix().lower() in supported_types:
        if paths.is_file():
            files.append(paths)
        elif paths.is_dir():
            files.extend(p for p in paths.rglob("*") if p.suffix().lower() in supported_types)
    else: print(f"{paths} is an unsupported file type.")

